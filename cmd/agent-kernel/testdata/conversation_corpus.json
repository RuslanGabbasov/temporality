      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "lead_first" },
      "expected_cascade": { "intent": "question", "execution": "direct", "level": "lead_first", "classifier_calls": 0 }
    },
    {
      "name": "second task in one conversation",
      "category": "multi_task",
      "text": "запусти рефакторинг ядра отдельной задачей",
      "active_task": true,
      "expected_deterministic": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic" },
      "expected_cascade": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic", "classifier_calls": 0, "note": "deterministic task verbs outrank the lead-first shortcut; the talk may carry several tasks" }
    },
    {
      "name": "same text from another source routes the same",
      "category": "multi_source",
      "text": "research the flaky matrix test",
      "expected_deterministic": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic" },
      "expected_cascade": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic", "classifier_calls": 0, "note": "routing is transport-independent; the transport only normalizes the text" }
    },
    {
      "name": "duplicate message keeps deterministic decision",
      "category": "duplicate_message",
      "text": "research the flaky matrix test",
      "expected_deterministic": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic" },
      "expected_cascade": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic", "classifier_calls": 0, "note": "dedup happens at ingestion (idempotent append); the router sees the text once and must stay deterministic" }
    },
    {
      "name": "attachments mean work",
      "category": "attachments",
      "text": "посмотри логи",
      "attachments": true,
      "expected_deterministic": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic" },
      "expected_cascade": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic", "classifier_calls": 0 }
    },
    {
      "name": "ambiguous command mid-band keeps default",
      "category": "ambiguous_command",
      "text": "ну сделай как-нибудь",
