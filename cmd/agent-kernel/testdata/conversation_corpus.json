      "expected_cascade": { "intent": "question", "execution": "direct", "level": "deterministic", "classifier_calls": 0, "note": "an injection phrase is just a conversational turn to the router: the lead's anti-injection system tail and operation-level authorization are the defenses, not the route selector" }
    },
    {
      "name": "clarify on very low confidence",
