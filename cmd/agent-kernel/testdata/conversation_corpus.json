      "expected_cascade": { "intent": "approval", "execution": "direct", "level": "fast_model", "classifier_calls": 1, "note": "a widget/button answer resolves through the Interaction Runtime; free text here is conversational approval" }
    },
    {
      "name": "one-word verdict among parallel asks clarifies",
      "category": "parallel_approvals",
      "text": "ок",
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "deterministic" },
      "classifier": { "intent": "approval", "execution": "clarification", "confidence": 0.9, "requires_clarification": true },
      "expected_cascade": { "intent": "unknown", "execution": "clarification", "level": "fast_model", "classifier_calls": 1, "note": "one-word verdict among several open asks must clarify, never FIFO-commit" }
    },
    {
      "name": "ambiguous multi-target phrasing clarifies",
      "category": "multi_target",
      "text": "ну запусти это на любом из проектов",
