      "classifier": { "intent": "task_request", "execution": "clarification", "confidence": 0.5 },
      "expected_cascade": { "intent": "unknown", "execution": "clarification", "level": "fast_model", "classifier_calls": 1 }
    },
    {
      "name": "question while task runs is lead-first",
      "category": "question_during_task",
      "text": "а сколько ещё осталось?",
