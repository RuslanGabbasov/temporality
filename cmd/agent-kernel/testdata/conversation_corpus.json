{
  "comment": "Regression corpus for the Fast Intent Router (docs/conversational-runtime.md §20): the 20 minimum categories, each case pinning initial state, message, and the expected routing decision. expected_deterministic is what the cascade must produce with NO model (level 1 + lead-first); expected_cascade is what it must produce with the scripted level-2 classifier answer in `classifier`; classifier_calls pins how many model rounds the cascade may spend. Confidence bands (§11.3): below 0.55 the cascade clarifies, 0.55-0.74 keeps the deterministic default, >= 0.75 adopts the classifier's verdict. Side-effect expectations are declarative only: the harness pins the decision layer, execution itself is pinned by the dispatch/turn tests.",
  "cases": [
    {
      "name": "simple question mid-band model keeps default",
      "category": "simple_question",
      "text": "Какой сейчас бюджет по проекту omni?",
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "deterministic" },
      "classifier": { "intent": "information_request", "execution": "direct", "confidence": 0.6 },
      "expected_cascade": { "intent": "question", "execution": "direct", "level": "fast_model", "classifier_calls": 1, "note": "mid-band confidence never overrides the deterministic default" }
    },
    {
      "name": "simple question ru confident model",
      "category": "simple_question",
      "text": "сколько задач в работе?",
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "deterministic" },
      "classifier": { "intent": "information_request", "execution": "direct", "confidence": 0.88 },
      "expected_cascade": { "intent": "information_request", "execution": "direct", "level": "fast_model", "classifier_calls": 1 }
    },
    {
      "name": "discussion of ideas",
      "category": "discussion",
      "text": "Давай обсудим, как лучше структурировать онбординг агентов",
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "deterministic" },
      "classifier": { "intent": "discussion", "execution": "direct", "confidence": 0.9 },
      "expected_cascade": { "intent": "discussion", "execution": "direct", "level": "fast_model", "classifier_calls": 1 }
    },
    {
      "name": "continuation of discussion",
      "category": "continuation",
      "text": "и ещё вот что по этой теме",
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "deterministic" },
      "classifier": { "intent": "discussion", "execution": "direct", "confidence": 0.85 },
      "expected_cascade": { "intent": "discussion", "execution": "direct", "level": "fast_model", "classifier_calls": 1 }
    },
    {
      "name": "topic switch inside active work is lead-first",
      "category": "topic_switch",
      "text": "ладно, забудь, давай про дашборд",
      "active_task": true,
      "expected_deterministic": { "intent": "question", "execution": "direct", "level": "lead_first" },
      "expected_cascade": { "intent": "question", "execution": "direct", "level": "lead_first", "classifier_calls": 0, "note": "a topic switch inside active work is a lead continuation, not a classification round" }
    },
    {
      "name": "research request en",
      "category": "research_request",
      "text": "research why the outbox redelivery doubled the answer",
      "expected_deterministic": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic" },
      "expected_cascade": { "intent": "task_request", "execution": "agent_execution", "level": "deterministic", "classifier_calls": 0 }
    },
    {
      "name": "research request ru",
      "category": "research_request",
