# Copy to .env and choose one provider. Never commit a real API key.

# OpenAI
TEMPORALITY_MODEL_BASE_URL=https://api.openai.com/v1
TEMPORALITY_MODEL_ID=gpt-4.1-mini
TEMPORALITY_MODEL_API_KEY=

# OpenRouter alternative:
# TEMPORALITY_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEMPORALITY_MODEL_ID=openai/gpt-4.1-mini
# TEMPORALITY_MODEL_API_KEY=

# Ollama alternative (from the kernel Compose container):
# Run first: ollama pull llama3.2
# TEMPORALITY_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# TEMPORALITY_MODEL_ID=llama3.2
# TEMPORALITY_MODEL_API_KEY=

TEMPORALITY_MODEL_TEMPERATURE=0
TEMPORALITY_MODEL_TIMEOUT=60s

# Reasoning models: off/exclude/low/medium/high; empty = do not send.
# TEMPORALITY_MODEL_REASONING=off
# Completion budget incl. chain-of-thought; raise for reasoning models.
# TEMPORALITY_MODEL_MAX_OUTPUT_TOKENS=16384

# Optional Kernel MCP stdio server (tool allowlist is required):
# KERNEL_MCP_COMMAND=
# KERNEL_MCP_ARGS=
# KERNEL_MCP_ALLOW=
# KERNEL_MCP_APPROVAL=

# Optional run_command sandbox (image pinned by digest, preloaded):
# TEMPORALITY_SANDBOX_ROOT=
# KERNEL_SANDBOX_IMAGE=
