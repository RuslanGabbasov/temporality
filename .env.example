# Copy to .env and choose one provider. Never commit a real API key.

# OpenAI
TEMPORALITY_MODEL_BASE_URL=https://api.openai.com/v1
TEMPORALITY_MODEL_ID=gpt-4.1-mini
TEMPORALITY_MODEL_API_KEY=

# OpenRouter alternative:
# TEMPORALITY_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEMPORALITY_MODEL_ID=openai/gpt-4.1-mini
# TEMPORALITY_MODEL_API_KEY=

# Ollama alternative (from the kernel Compose container):
# Run first: ollama pull llama3.2
# TEMPORALITY_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# TEMPORALITY_MODEL_ID=llama3.2
# TEMPORALITY_MODEL_API_KEY=

TEMPORALITY_MODEL_TEMPERATURE=0
TEMPORALITY_MODEL_TIMEOUT=60s

# Reasoning models: off/exclude/low/medium/high; empty = do not send.
# TEMPORALITY_MODEL_REASONING=off
# Completion budget incl. chain-of-thought; raise for reasoning models.
# TEMPORALITY_MODEL_MAX_OUTPUT_TOKENS=16384

# Optional Kernel MCP stdio server (tool allowlist is required):
# KERNEL_MCP_COMMAND=
# KERNEL_MCP_ARGS=
# KERNEL_MCP_ALLOW=
# KERNEL_MCP_APPROVAL=

# Optional run_command sandbox (image pinned by digest, preloaded):
# TEMPORALITY_SANDBOX_ROOT=
# KERNEL_SANDBOX_IMAGE=

# --- Bearer auth (control plane minimum) ---
# Empty = auth disabled with a startup warning (local dev only).
# Format per entry: token:subject:role:projects
#   role: reader < writer < operator < admin
#   projects: '*' or comma-separated list
# Entries separated by ';' or newlines. Generate tokens: openssl rand -hex 24
# JOURNAL_AUTH_TOKENS=reader-token:alice:reader:*;writer-token:bob:writer:lighthouse;operator-token:carol:operator:*
# Journal API (reads, ingest, invalidation):
# JOURNAL_AUTH_TOKENS=
# Kernel API (runs, approvals) and kernel->journal access:
# KERNEL_AUTH_TOKENS=
# TEMPORALITY_API_TOKEN=
# Optional MCP server identity in mcp.call.* events:
# KERNEL_MCP_SERVER_NAME=

# Reconciliation drill: set to an operation id to let its effect land and then
# crash the worker before the terminal event is written (kernel reads this).
KERNEL_FAULT_AFTER_EFFECT=

# Daily run quotas per project (kernel): "project:limit" comma list, "*" sets
# the default; empty disables quotas. Example: KERNEL_RUN_QUOTAS=*:50,forge:200
KERNEL_RUN_QUOTAS=

# --- Outbound notification channels (ask_human delivery) ---
# Bot-mediated transports need kernel-side credentials; until set, the
# channel registry reports them as not configured and users' preferred
# channels fall back to the web inbox. Users add their own addresses
# (room id / chat id / webhook URL) in the UI: user menu -> Notification
# channels.
# Matrix bot (homeserver must be reachable from the kernel container):
# KERNEL_MATRIX_HOMESERVER=https://matrix.org
# KERNEL_MATRIX_ACCESS_TOKEN=
# Telegram bot (get a token from @BotFather; users start the bot and paste
# their chat id as the channel address):
# KERNEL_TELEGRAM_BOT_TOKEN=
# Shared secret signing generic webhook payloads (X-Temporality-Signature:
# sha256-<hmac>). Optional: unset sends unsigned.
# KERNEL_WEBHOOK_SECRET=
# Base URL of the UI, used for answer links inside notifications:
# KERNEL_UI_URL=http://localhost:3000

# Secrets via files (compose secrets / 12-factor _FILE convention): when a
# VAR is unset and VAR_FILE points at a file, the trimmed file content is
# used. Supported: DATABASE_URL, TEMPORALITY_MODEL_API_KEY,
# TEMPORALITY_API_TOKEN, KERNEL_AUTH_TOKENS (kernel); JOURNAL_AUTH_TOKENS
# (journal). Plain env values always win.
# TEMPORALITY_MODEL_API_KEY_FILE=/run/secrets/model_api_key

# Model cost prices: "model:prompt_per_1k:completion_per_1k" comma list.
# Example: KERNEL_MODEL_PRICES="gpt-4o:2.50:10.00,claude-3-sonnet:3.00:15.00"
KERNEL_MODEL_PRICES=
