{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://temporality.dev/schemas/frp/v0.3/AffordanceDefinition.schema.json","title":"FRP AffordanceDefinition","type":"object","required":["protocol","version","id","execution_mode","input_schema","capabilities","limits","planner","failure_policy"],"properties":{"protocol":{"const":"frp"},"version":{"const":"0.3"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},"execution_mode":{"enum":["deterministic","adaptive"]},"input_schema":{"type":"object"},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}},"limits":{"type":"object","required":["timeout_sec","cpu","memory_mb","disk_mb"],"properties":{"timeout_sec":{"type":"integer","minimum":1},"cpu":{"type":"number","exclusiveMinimum":0},"memory_mb":{"type":"integer","minimum":1},"disk_mb":{"type":"integer","minimum":1}},"additionalProperties":false},"planner":{"type":"object","required":["enabled"],"properties":{"enabled":{"type":"boolean"},"model":{"type":"string","minLength":1},"max_steps":{"type":"integer","minimum":1}},"additionalProperties":false},"failure_policy":{"type":"object","required":["retry_transient","allow_strategy_change","max_retries"],"properties":{"retry_transient":{"type":"boolean"},"allow_strategy_change":{"type":"boolean"},"max_retries":{"type":"integer","minimum":0}},"additionalProperties":false}},"allOf":[{"if":{"properties":{"execution_mode":{"const":"deterministic"}}},"then":{"properties":{"planner":{"properties":{"enabled":{"const":false}},"not":{"anyOf":[{"required":["model"]},{"required":["max_steps"]}]}},"failure_policy":{"properties":{"allow_strategy_change":{"const":false}}}}}},{"if":{"properties":{"execution_mode":{"const":"adaptive"}}},"then":{"properties":{"planner":{"required":["enabled","model","max_steps"],"properties":{"enabled":{"const":true}}}}}}],"additionalProperties":false}