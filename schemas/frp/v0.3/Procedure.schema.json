{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporality.dev/schemas/frp/v0.3/Procedure.schema.json",
  "title": "FRP 0.3 Procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "procedure_id", "episode_id", "semantic_trigger", "preconditions", "affordance_sequence", "expected_outcomes", "evidence_execution_ids", "successes", "failures", "success_rate", "projection_version"],
  "properties": {
    "protocol": { "const": "frp" },
    "version": { "const": "0.3" },
    "procedure_id": { "type": "string", "format": "uuid" },
    "episode_id": { "type": "string", "format": "uuid" },
    "semantic_trigger": { "type": "string", "minLength": 1 },
    "preconditions": {
      "type": "object", "additionalProperties": false, "required": ["required_arguments"],
      "properties": { "required_arguments": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }
    },
    "affordance_sequence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["position", "affordance_id"], "properties": { "position": { "type": "integer", "minimum": 0 }, "affordance_id": { "type": "string", "minLength": 1 } } }
    },
    "expected_outcomes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "completed" } } }
    },
    "evidence_execution_ids": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
    "successes": { "type": "integer", "minimum": 0 },
    "failures": { "type": "integer", "minimum": 0 },
    "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "projection_version": { "const": "procedure-projector.v1" }
  }
}
