{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporality.dev/schemas/frp/v0.3/timetravel/Snapshot.schema.json",
  "title": "FRP Inline Snapshot",
  "type": "object",
  "required": ["metadata", "content"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["protocol", "protocol_version", "snapshot_version", "snapshot_id", "episode_id", "created_at", "through", "content_hash"],
      "properties": {
        "protocol": { "const": "frp" },
        "protocol_version": { "const": "0.3" },
        "snapshot_version": { "const": "1" },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "episode_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "through": { "$ref": "#/$defs/cursor" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "content": {}
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "required": ["tx_time", "event_id"],
      "properties": {
        "tx_time": { "type": "string", "format": "date-time" },
        "event_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
